active-journey ::= null | active-journey-1
active-journey-1 ::= "\"" ([A-Za-z0-9._:-]+) "\""
active-journey-kv ::= "\"active_journey\"" space ":" space active-journey
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
confidence-kv ::= "\"confidence\"" space ":" space number
customer-need ::= "\"" char{0,500} "\""
customer-need-kv ::= "\"customer_need\"" space ":" space customer-need
decimal-part ::= [0-9]{1,16}
dialogue-act ::= ("\"greet\"" | "\"chitchat\"" | "\"start_journey\"" | "\"continue_journey\"" | "\"answer_side_question\"" | "\"suspend_journey\"" | "\"resume_journey\"" | "\"switch_topic\"" | "\"correct_information\"" | "\"clarify_reference\"" | "\"repeat\"" | "\"cancel\"" | "\"close\"" | "\"handoff\"")
dialogue-act-kv ::= "\"dialogue_act\"" space ":" space dialogue-act
facts-added ::= "{" space  (facts-added-additional-kv ( "," space facts-added-additional-kv )* )? space "}"
facts-added-additional-kv ::= string ":" space facts-added-additional-value
facts-added-additional-value ::= null | facts-added-additional-value-1 | number | boolean
facts-added-additional-value-1 ::= "\"" char{0,500} "\""
facts-added-kv ::= "\"facts_added\"" space ":" space facts-added
facts-corrected ::= "{" space  (facts-corrected-additional-kv ( "," space facts-corrected-additional-kv )* )? space "}"
facts-corrected-additional-kv ::= string ":" space facts-corrected-additional-value
facts-corrected-additional-value ::= null | facts-corrected-additional-value-1 | number | boolean
facts-corrected-additional-value-1 ::= "\"" char{0,500} "\""
facts-corrected-kv ::= "\"facts_corrected\"" space ":" space facts-corrected
integral-part ::= [0] | [1-9] [0-9]{0,15}
knowledge-queries ::= "[" space (knowledge-queries-item ("," space knowledge-queries-item){0,7})? space "]"
knowledge-queries-item ::= "\"" (knowledge-queries-item-1{1,120}) "\""
knowledge-queries-item-1 ::= [A-Za-z0-9._:-]
knowledge-queries-kv ::= "\"knowledge_queries\"" space ":" space knowledge-queries
next-required-information ::= null | next-required-information-1
next-required-information-1 ::= "\"" char{0,500} "\""
next-required-information-kv ::= "\"next_required_information\"" space ":" space next-required-information
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
question-to-answer ::= null | question-to-answer-1
question-to-answer-1 ::= "\"" char{0,500} "\""
question-to-answer-kv ::= "\"question_to_answer\"" space ":" space question-to-answer
references-resolved ::= "{" space  (references-resolved-additional-kv ( "," space references-resolved-additional-kv )* )? space "}"
references-resolved-additional-kv ::= string ":" space references-resolved-additional-value
references-resolved-additional-value ::= null | references-resolved-additional-value-1 | number | boolean
references-resolved-additional-value-1 ::= "\"" char{0,500} "\""
references-resolved-kv ::= "\"references_resolved\"" space ":" space references-resolved
requested-action ::= null | requested-action-1
requested-action-1 ::= "{" space requested-action-1-tool-kv "," space requested-action-1-arguments-kv space "}"
requested-action-1-arguments ::= object
requested-action-1-arguments-kv ::= "\"arguments\"" space ":" space requested-action-1-arguments
requested-action-1-tool ::= ("\"get_active_conversation_state\"" | "\"search_tata_knowledge\"" | "\"get_service_playbook\"" | "\"get_verified_public_information\"" | "\"get_allowed_actions\"" | "\"get_pending_questions\"" | "\"resolve_reference_candidates\"" | "\"prepare_handoff\"")
requested-action-1-tool-kv ::= "\"tool\"" space ":" space requested-action-1-tool
requested-action-kv ::= "\"requested_action\"" space ":" space requested-action
return-to-previous-topic-kv ::= "\"return_to_previous_topic\"" space ":" space boolean
root ::= "{" space dialogue-act-kv "," space social-act-kv "," space active-journey-kv "," space topic-changed-kv "," space return-to-previous-topic-kv "," space facts-added-kv "," space facts-corrected-kv "," space references-resolved-kv "," space customer-need-kv "," space question-to-answer-kv "," space next-required-information-kv "," space knowledge-queries-kv "," space requested-action-kv "," space confidence-kv space "}"
social-act ::= ("\"none\"" | "\"greet\"" | "\"return_greeting\"" | "\"thank\"" | "\"acknowledge\"" | "\"apologize\"" | "\"farewell\"")
social-act-kv ::= "\"social_act\"" space ":" space social-act
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
topic-changed-kv ::= "\"topic_changed\"" space ":" space boolean
value ::= object | array | string | number | boolean | null
