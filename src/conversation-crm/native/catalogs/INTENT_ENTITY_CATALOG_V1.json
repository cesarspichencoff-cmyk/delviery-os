  "entities": [
    {
      "id": "unit",
      "type": "enum",
      "privacy": "operational",
      "examples": [
        "UNIDADE_EXEMPLO_A"
      ]
    },
    {
      "id": "customer_name",
      "type": "text",
      "privacy": "personal",
      "storage": "restricted_runtime_only"
    },
    {
      "id": "party_size",
      "type": "integer",
      "privacy": "operational",
      "constraints": {
        "min": 1
      }
    },
    {
      "id": "arrival_estimate",
      "type": "time_window",
      "privacy": "operational"
    },
    {
      "id": "pickup_time",
      "type": "time_window",
      "privacy": "operational"
    },
    {
      "id": "requested_items",
      "type": "array",
      "privacy": "operational"
    },
    {
      "id": "order_reference",
      "type": "token",
      "privacy": "pseudonymous",
      "rule": "Nunca exibir número completo real em log ou fixture."
    },
    {
      "id": "order_channel",
      "type": "enum",
      "values": [
        "ifood",
        "delivery_own",
        "pickup",
        "dining_room",
        "unknown"
      ]
    },
    {
      "id": "item_name",
      "type": "text",
      "privacy": "operational",
      "rule": "Normalizar contra cardápio confirmado; texto livre fica restrito."
    },
    {
      "id": "symptoms",
      "type": "restricted_array",
      "privacy": "sensitive_health",
      "storage": "need_to_know"
    },
    {
      "id": "onset",
      "type": "restricted_time_window",
      "privacy": "sensitive_health"
    },
    {
      "id": "people_affected",
      "type": "integer",
      "privacy": "sensitive_health"
    },
    {
      "id": "evidence_available",
      "type": "enum",
      "values": [
        "yes",
        "no",
        "unknown"
      ]
    },
    {
      "id": "message_original",
      "type": "text",
      "privacy": "personal_possible",
      "storage": "handoff_restricted_only",
      "rule": "Não copiar para analytics ou fixtures."
    },
    {
      "id": "photo_reference",
      "type": "opaque_reference",
      "privacy": "personal_possible",
      "storage": "restricted_runtime_only"
    },
    {
      "id": "capability_state",
      "type": "enum",
