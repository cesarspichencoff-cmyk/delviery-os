{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts",
    "tools/entregas_ui_server.ts",
    "tools/entregas_pilot_server.ts",
    "tools/product_system_server.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
