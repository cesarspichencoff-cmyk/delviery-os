<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada do banco local sai do aparelho por backup ou transferencia: ele contem
  coordenadas de viagem. Reinstalar o app comeca do zero, de proposito.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
