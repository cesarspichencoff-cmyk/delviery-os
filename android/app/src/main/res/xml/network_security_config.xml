<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: somente TLS com as autoridades do sistema. Sem exceção, sem
  cleartext, sem certificado de desenvolvimento.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
