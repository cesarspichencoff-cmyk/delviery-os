/node_modules
/dist
android/*.log
/data/*.jsonl
# Saída de runtime do Conference Brain. `storage/store.js` escreve
# `<entidade>.runtime.jsonl` em `data/conference-brain/` e o comentário dele já
# AFIRMAVA que isso era gitignorado — mas a regra acima (`/data/*.jsonl`) não
# alcança subdiretório, e um arquivo de teste com `source_mode: "real"` acabou
# versionado em `a6e38ed`. Guarda: `npm run test:platform:higiene`.
/data/conference-brain/*.runtime.jsonl
**/*.runtime.jsonl
# Estágio da publicação deliberada de evidências do Lab V4
# (`npm run evidence:lab:v4:refresh`). Precisa ser ADJACENTE ao alvo, porque
# `rename` só é atômico dentro do mesmo sistema de arquivos — e por isso cai
# dentro da worktree. Uma execução morta no meio deixa o estágio para trás, e
# isso não pode sujar `git status`. Guarda: `npm run test:lab:v4:evidencias`.
/labs/operacao-viva-v4/.evidencias-staging-*/
/labs/operacao-viva-v4/.evidencias-velho-*/
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/incoming/
/data/raw/incoming/*
!/data/raw/incoming/.gitkeep
/data/canonico/*
!/data/canonico/.gitkeep
/data/generated/*
!/data/generated/.gitkeep
*.tsbuildinfo
.DS_Store
.env
docs/*.pdf

var/
_tmp_*


# Piloto ENTREGAS
config/entregas-pilot.json
config/entregas-geofence.json
config/entregas-unit-*.json
config/entregas-gps-flags.json
config/entregas-devices.json
config/entregas-term.json
config/entregas-pilot.json
data/entregas-pilot/

# TLS local do piloto — chave privada e certificado NUNCA entram no Git.
# Os caminhos são configurados por ENTREGAS_TLS_CERT / ENTREGAS_TLS_KEY.
certs/
*.pem
*.key
*.crt
*.pfx
*.p12

# Android — artefatos de build e chaves de assinatura
android/.gradle/
android/gate-verification/.gradle/
android/gate-verification/build/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
*.keystore
*.jks
android/keystore.properties

# Deploy do piloto de nuvem — segredos e certificados nunca versionados
deploy/.env
deploy/.env.*
# Os arquivos `*.example` sao o contrato de configuracao: nomes de variaveis,
# nunca valores. Precisam estar versionados — a auditoria de deploy os le, e
# num clone limpo ela falharia sem eles.
!deploy/.env.*.example
deploy/certs/
deploy/config/
deploy/dados/
