{
  "name": "deliveryos-core",
  "version": "0.0.0",
  "private": true,
  "description": "DeliveryOS — Camada 0: motor de escuta, memória append-only e projeções (sem tela, sem chão).",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "demo": "tsc && node dist/demo/camada0_demo.js",
    "ingest": "tsc && node dist/demo/ingest_real.js",
    "verificar:cardapio": "node tools/verificar_integridade_cardapio.js",
    "copiloto:fixtures": "node mocks/copiloto/generate-fixtures.js",
    "copiloto:test": "node tests/copiloto/run.js",
    "capacidade:test": "node tests/capacidade-viva/run.js",
    "capacidade:calibration:test": "node tests/capacidade-viva/calibration/run.js",
    "capacidade:calibrar": "node tools/calibrar_capacidade_viva.js",
    "serve": "node tools/servir_v1.js"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.5.3",
    "xlsx": "^0.18.5"
  }
}
