{
  "name": "deliveryos-core",
  "version": "0.0.0",
  "private": true,
  "description": "DeliveryOS — Camada 0: motor de escuta, memória append-only e projeções (sem tela, sem chão).",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "demo": "tsc && node dist/demo/camada0_demo.js",
    "ingest": "tsc && node dist/demo/ingest_real.js",
    "verificar:cardapio": "node tools/verificar_integridade_cardapio.js",
    "test:edge:shadow": "tsc && node dist/demo/edge_shadow_proof.js",
    "test:edge:runtime": "tsc && node dist/demo/edge_runtime_proof.js",
    "test:edge:ifood": "tsc && node dist/demo/edge_ifood_shadow_proof.js",
    "test:edge:print": "tsc && node dist/demo/edge_print_shadow_proof.js",
    "test:edge:shadow:all": "npm run test:edge:shadow && npm run test:edge:runtime && npm run test:edge:ifood && npm run test:edge:print && npm run test:edge:sources && npm run test:edge:projection && npm run test:edge:admission && npm run test:edge:browser && npm run test:edge:windows-print && npm run test:edge:transport && npm run test:edge:powershell-print && npm run test:edge:envelope && npm run test:edge:store-recovery && npm run test:edge:attention && npm run test:edge:store-port && npm run test:edge:promotion && npm run test:edge:manager-snapshot && npm run test:context:foundation && npm run test:context:capture-schedule && npm run test:context:source-adapters && npm run test:context:attention-policy && npm run test:context:cycle && npm run test:context:source-runtime && npm run test:context:temporal-baseline && npm run test:context:episode-alignment && npm run test:context:episode-recurrence && npm run test:context:action-followup && npm run test:context:caixa-pulse-episode-adapter && npm run test:context:expected-barrier && npm run test:context:temporal-outcome-alignment && npm run test:edge:watch-handoff && npm run test:edge:watch-transport && npm run test:watch-shadow-worker && npm run test:edge:cloud-producer && npm run test:gerencial-mail-bridge",
    "test:edge:sources": "tsc && node dist/demo/edge_sources_bridge_proof.js",
    "test:edge:projection": "tsc && node dist/demo/edge_projection_rebuild_proof.js",
    "test:edge:admission": "tsc && node dist/demo/edge_admission_pipeline_proof.js",
    "test:edge:browser": "tsc && node dist/demo/edge_ifood_browser_transport_proof.js",
    "test:edge:windows-print": "tsc && node dist/demo/edge_windows_print_source_proof.js",
    "test:edge:transport": "tsc && node dist/demo/edge_transport_cycle_proof.js",
    "test:edge:powershell-print": "tsc && node dist/demo/edge_powershell_print_adapter_proof.js",
    "test:edge:envelope": "tsc && node dist/demo/edge_source_envelope_proof.js",
    "test:edge:store-recovery": "tsc && node dist/demo/edge_store_recovery_proof.js",
    "test:edge:attention": "tsc && node dist/demo/edge_attention_projection_proof.js",
    "test:edge:store-port": "tsc && node dist/demo/edge_store_port_proof.js",
    "test:edge:promotion": "tsc && node dist/demo/edge_promotion_gate_proof.js",
    "test:edge:manager-snapshot": "tsc && node dist/demo/edge_manager_snapshot_proof.js",
    "test:context:foundation": "tsc && node dist/demo/context_kernel_foundation_proof.js",
    "test:context:capture-schedule": "tsc && node dist/demo/context_kernel_capture_schedule_proof.js",
    "test:context:source-adapters": "tsc && node dist/demo/context_kernel_source_adapters_proof.js",
    "test:context:attention-policy": "tsc && node dist/demo/context_kernel_attention_policy_proof.js",
    "test:context:cycle": "tsc && node dist/demo/context_kernel_cycle_proof.js",
    "test:context:source-runtime": "tsc && node dist/demo/context_kernel_source_runtime_proof.js",
    "test:context:temporal-baseline": "tsc && node dist/demo/context_kernel_temporal_baseline_proof.js",
    "replay:context:temporal-baseline": "tsc && node dist/demo/context_kernel_temporal_baseline_replay.js",
    "test:context:temporal-outcome-alignment": "tsc && node dist/demo/context_kernel_temporal_outcome_alignment_proof.js",
    "replay:context:temporal-outcome-alignment": "tsc && node dist/demo/context_kernel_temporal_outcome_alignment_replay.js",
    "test:edge:watch-handoff": "tsc && node dist/demo/edge_gerencial_watch_handoff_proof.js",
    "test:edge:watch-transport": "tsc && node dist/demo/edge_gerencial_watch_transport_proof.js",
    "test:watch-shadow-worker": "node --test deploy/cloudflare/gerencial-watch-shadow/test/*.test.mjs",
    "smoke:edge:watch-shadow-live": "tsc && node dist/demo/edge_watch_shadow_http_smoke.js",
    "test:edge:cloud-producer": "node --test deploy/cloudflare/tata-edge-cloud-shadow/test/*.test.mjs",
    "test:gerencial-mail-bridge": "node --test deploy/cloudflare/gerencial-mail-bridge/src/*.test.mjs",
    "smoke:edge:cloud-producer-live": "node deploy/cloudflare/tata-edge-cloud-shadow/smoke-live.mjs",
    "test:context:episode-alignment": "tsc && node dist/demo/context_kernel_episode_alignment_proof.js",
    "test:context:episode-recurrence": "tsc && node dist/demo/context_kernel_episode_recurrence_proof.js",
    "test:context:action-followup": "tsc && node dist/demo/context_kernel_action_followup_proof.js",
    "test:context:caixa-pulse-episode-adapter": "tsc && node dist/demo/context_kernel_caixa_pulse_episode_adapter_proof.js",
    "test:context:expected-barrier": "tsc && node dist/demo/context_kernel_expected_barrier_proof.js",
    "replay:context:caixa-pulse-action-followup": "tsc && node dist/demo/context_kernel_caixa_pulse_action_followup_replay.js"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.5.3",
    "xlsx": "^0.18.5"
  }
}
