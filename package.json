    "verificar:production-service-matrix": "tsc && node tools/verificar_production_service_matrix_v1.js",
    "verificar:resource-consumption": "tsc && node tools/verificar_resource_consumption_v1.js",
    "verificar:production-ticket-v2": "tsc && node tools/verificar_production_ticket_v2.js",
    "verificar:tickets-operacionais-v45": "tsc && node tools/verificar_operational_tickets_v45.js",
    "verificar:tickets-reais-v46": "tsc && node tools/verificar_real_order_tickets_v46.js && node tools/verificar_operational_escpos_v46.js",
    "verificar:two-kitchen-v47": "tsc && node tools/verificar_two_kitchen_tickets_v47.js",
    "verificar:kitchen-real-v48": "tsc && node tools/verificar_kitchen_real_replay_v48.js",
    "verificar:kitchen-sushi-quente-v49": "tsc && node tools/verificar_kitchen_sushi_quente_v49.js",
