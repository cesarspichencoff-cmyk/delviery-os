    "gerar:replay-cozinha-v48:offline": "tsc && node tools/gerar_replay_cozinha_separada_v48.js",
    "gerar:provas-termicas-v46:offline": "tsc && node tools/gerar_provas_termicas_v46.js",
    "projetar:tickets-operacionais-v45:shadow": "tsc && node tools/projetar_operational_tickets_v45_stdin.js",
    "verificar:production-ticket-e2e": "tsc && node tools/verificar_production_ticket_e2e_shadow_v1.js",
    "verificar:tata-os-print-handoff": "tsc && node tools/verificar_tata_os_print_handoff_v1.js",
    "verificar:native-nfce-orchestration": "tsc && node tools/verificar_native_nfce_orchestration_v1.js",
    "verificar:production-printer-preflight-static": "node tools/verificar_production_printer_preflight_static_v1.js",
    "verificar:windows-spooler-evidence": "tsc && node tools/verificar_windows_spooler_evidence_v1.js",
    "verificar:mooca-commandas-preflight-static": "node tools/verificar_mooca_commandas_preflight_static_v1.js",
    "verificar:mooca-preflight-standalone-static": "node tools/verificar_mooca_preflight_standalone_static_v1.js",
    "verificar:odhen-fiscal-surface-probe-static": "node tools/verificar_odhen_fiscal_surface_probe_static_v1.js",
    "verificar:resource-costing": "tsc && node tools/verificar_resource_costing_v1.js",
    "verificar:native-fiscal-reconciler": "tsc && node tools/verificar_native_fiscal_reconciler_v1.js",
    "verificar:tata-sequence": "tsc && node tools/verificar_tata_sequence_v1.js",
    "verificar:tata-sequence-policy": "tsc && node tools/verificar_tata_sequence_policy_v1.js"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.5.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
