    "verificar:production-ticket": "tsc && node tools/verificar_production_ticket_v1.js",
    "verificar:print-topology-probe-static": "node tools/verificar_odhen_print_topology_probe_static.js",
    "verificar:imp-printer-metadata-static": "node tools/verificar_imp_printer_metadata_monitor_static.js",
    "verificar:production-parallel": "tsc && node tools/verificar_production_parallel_v1.js",
    "verificar:production-parallel-static": "node tools/verificar_production_parallel_static.js",
    "verificar:shadow": "tsc && node tools/verificar_shadow_odhen_v132.js",
    "verificar:routing-config": "node tools/verificar_odhen_product_routing_config_v1.js",
    "verificar:expected-routing": "tsc && node tools/verificar_expected_routing_v1.js",
    "verificar:real-routing-sample": "node tools/verificar_real_sale_routing_sample_v1.js",
    "verificar:shadow-routing-chain": "tsc && node tools/verificar_shadow_odhen_routing_chain_v1.js",
    "verificar:odhen-routing-readonly": "tsc && node tools/verificar_odhen_routing_readonly_v1.js",
    "projetar:odhen-routing-stdin": "tsc && node tools/projetar_odhen_routing_stdin_v1.js",
    "verificar:retail-routing-tooling": "node tools/verificar_retail_routing_config_tooling_v1.js",
    "verificar:routing-drift": "node tools/verificar_routing_config_drift_v1.js",
    "verificar:pracas-vs-retail": "node tools/verificar_pracas_vs_retail_v1.js",
    "auditar:pracas-vs-retail": "node tools/auditar_pracas_vs_retail_v1.js",
    "auditar:delivery-active-routing": "node tools/auditar_delivery_active_routing_coverage_v1.js",
    "verificar:delivery-active-routing": "node tools/verificar_delivery_active_routing_coverage_v1.js",
