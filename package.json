{
  "name": "deliveryos-core",
  "version": "0.0.0",
  "private": true,
  "description": "DeliveryOS — Camada 0: motor de escuta, memória append-only e projeções (sem tela, sem chão).",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "demo": "tsc && node dist/demo/camada0_demo.js",
    "ingest": "tsc && node dist/demo/ingest_real.js",
    "verificar:cardapio": "node tools/verificar_integridade_cardapio.js",
    "copiloto:fixtures": "node mocks/copiloto/generate-fixtures.js",
    "copiloto:test": "node tests/copiloto/run.js",
    "capacidade:test": "node tests/capacidade-viva/run.js",
    "conversation-crm:test": "node --test tests/conversation-crm/*.test.js",
    "conversation-crm:start": "node tools/conversation-crm/simulator/server.js",
    "conversation-crm:config:export": "node tools/conversation-crm/config-cli.js export",
    "conversation-crm:config:import": "node tools/conversation-crm/config-cli.js import",
    "conversation-native:test": "node --test tests/conversation-crm/*.test.js",
    "conversation-native:start": "node tools/conversation-crm/native-server.js",
    "conversation-native:scenario": "node tools/conversation-crm/native-simulator.js scenario",
    "conversation-native:catalog": "node tools/conversation-crm/native-simulator.js all",
    "conversation-native:reproduce": "node tools/conversation-crm/native-simulator.js reproduce",
    "conversation-native:privacy": "node tools/conversation-crm/native-privacy-scan.js",
    "serve": "node tools/servir_v1.js"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.5.3",
    "xlsx": "^0.18.5"
  }
}
