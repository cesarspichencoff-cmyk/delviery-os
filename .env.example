# DeliveryOS — variáveis de ambiente locais
#
# Copie este arquivo para ".env" (não versionado) e ajuste os caminhos para a sua máquina.
# Nenhuma delas é obrigatória: todo script tem um padrão relativo ao próprio repo
# (ver docs/Politica_Dados.md). Use estas variáveis só se seus arquivos ficarem
# em outro lugar.
#
# Como carregar: este projeto não usa uma lib de .env (sem dependência nova).
# Exporte manualmente antes de rodar, por exemplo:
#   set -a; source .env; set +a   (bash/git-bash)
#   Get-Content .env | ForEach-Object { ... }   (PowerShell, se preferir)
# ou defina a variável só para o comando: DELIVERYOS_RELATORIO_IFOOD=/caminho npm run ingest

# Caminho do relatório de pedidos iFood (.xlsx ou .xlsx.zip — ambos funcionam) usado por
# `npm run ingest` e por `node tools/autoteste_8pracas.js`.
# Padrão se não definido: data/raw/relatorio_pedidos_ifood.xlsx
DELIVERYOS_RELATORIO_IFOOD=

# Caminho do log de transições da Camada 0 (LogJsonl). Só é usado por código que
# escolher LogJsonl em vez de LogMemoria (hoje nenhum script padrão usa).
# Padrão se não definido: data/transicoes.jsonl
DELIVERYOS_LOG=

# ==============================================================================
# Conference Brain — observador ao vivo do iFood (Sprint 2 / 2.1)
# NUNCA coloque um valor real de sessão neste arquivo nem no .env local sem
# revisar antes de qualquer commit. Nenhuma destas variáveis é obrigatória —
# sem elas, o coletor ao vivo simplesmente não sobe (ver flags.js, leitura
# ESTRITA: nunca liga sozinho por a variável estar ausente).
# ==============================================================================

# Liga os módulos que só tocam lógica local (relógio, painel). Sprint 1 já
# usa NODE_ENV=development|test para ligar por padrão; estas seguem o mesmo padrão.
CONFERENCE_BRAIN_FOUNDATION_V1=
CONFERENCE_CLOCK_V1=
CONFERENCE_OPERATOR_PANEL_V1=

# Leitura ESTRITA — só "1" liga, em qualquer ambiente, inclusive dev/teste.
# Tocam (ou podem vir a tocar) uma sessão real do navegador.
CONFERENCE_LIVE_OBSERVER_V1=
CONFERENCE_IFOOD_MAPPING_MODE_V1=

# Caminho do executável do Chromium JÁ INSTALADO na máquina (nunca baixado por
# este projeto). Ilustrativo — ajuste para o seu sistema:
#   Windows: C:\Users\<usuario>\AppData\Local\ms-playwright\chromium-<versao>\chrome-win\chrome.exe
CONFERENCE_IFOOD_CHROMIUM_EXECUTABLE=

# Diretório do PERFIL PERSISTENTE do Chromium com a sessão do Gestor já
# autorizada por um humano. SEMPRE fora do repositório; nunca commitado.
#   Windows: %LOCALAPPDATA%\DeliveryOS\ifood-browser-profile\
CONFERENCE_IFOOD_BROWSER_PROFILE_DIR=

# URL única que o coletor tem permissão de navegar (o Gestor de Pedidos).
CONFERENCE_IFOOD_ALLOWED_URL=

# Unidade esperada — o coletor nunca mistura pedidos de unidades diferentes;
# sem confirmar isto, a leitura nunca é tratada como confiante (ver
# live/store-state.js#accountContextBlocksConfidentReading).
CONFERENCE_IFOOD_EXPECTED_UNIT_ID=

# Diretório de evidência sanitizada (assinaturas estruturais, nunca HTML bruto
# nem screenshot com PII). Fora do Git por padrão (.gitignore já cobre
# data/conference-brain/live-evidence/).
CONFERENCE_IFOOD_EVIDENCE_DIR=

# Timing do ciclo (ms). Padrões em live/browser-adapter.js#DEFAULTS: intervalo
# 30000, mínimo 10000, timeout 15000, stale 300000, retenção 7 dias.
CONFERENCE_IFOOD_CYCLE_INTERVAL_MS=
CONFERENCE_IFOOD_CYCLE_TIMEOUT_MS=
CONFERENCE_IFOOD_EVIDENCE_RETENTION_DAYS=
