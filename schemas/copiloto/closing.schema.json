{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tata.local/schemas/copiloto/closing.schema.json",
  "title": "ShiftClosing",
  "type": "object",
  "required": ["schema_version", "summary", "questions", "constraints", "flow"],
  "properties": {
    "schema_version": { "type": "string" },
    "summary": { "type": "object" },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question_id", "text", "observed", "unknown", "why_it_helps"],
        "properties": {
          "question_id": { "type": "string" },
          "text": { "type": "string" },
          "observed": { "type": "string" },
          "unknown": { "type": "string" },
          "why_it_helps": { "type": "string" },
          "info_gain": { "type": "number" },
          "options_hint": { "type": "array" },
          "type": { "type": "string" }
        }
      }
    },
    "audio_script": { "type": "object" },
    "constraints": {
      "type": "object",
      "properties": {
        "ideal_seconds": { "type": "number" },
        "max_seconds": { "type": "number", "maximum": 120 },
        "max_questions": { "type": "number", "maximum": 3 },
        "allow_skip": { "type": "boolean" },
        "allow_dont_know": { "type": "boolean" },
        "no_emotion_analysis": { "type": "boolean", "const": true }
      }
    },
    "flow": { "type": "array", "items": { "type": "string" } }
  }
}
