# DeliveryOS — imagem dos runtimes crítico e assíncrono
#
# NÃO CONSTRUÍDO NESTA MÁQUINA: não há Docker aqui. O arquivo está completo e
# revisado, mas `docker build` ainda não passou nele. O relatório do Macro-
# Prompt 1 diz exatamente o que isso deixa não comprovado.
#
# Uma imagem só para os dois runtimes, com comandos diferentes. Duas imagens
# separadas garantiriam duas versões do mesmo código no ar ao mesmo tempo,
# que é a origem de "funciona no crítico e falha no worker".
#
# Build a partir da RAIZ do repositório:
#   docker build -f deploy/Dockerfile.platform -t deliveryos-platform:v1 .

# ---------------------------------------------------------------- build
FROM node:22-bookworm-slim AS build

WORKDIR /build

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install --no-audit --no-fund; fi

COPY tsconfig.json ./
COPY src ./src
COPY tools ./tools
COPY demo ./demo
# SÓ os contratos, não `docs/` inteiro: `contracts/eventos.schema.json` é lido
# em RUNTIME pela rota de ingestão, e sem ele a imagem sobe com /ready 200 e
# recusa todo GPS com 503 (PB19-D3b). `copiar_contratos.js` os leva a
# `dist/docs/contracts/`, que é o que o estágio de runtime copia.
COPY docs/contracts ./docs/contracts

# Compila e copia para dist/ o que o `tsc` ignora — ele só entende TypeScript.
# Cada passo fecha um defeito já medido nesta base:
#   migrations  sem elas a imagem sobe sem schema e acha que não há pendência;
#   Conference Brain  sem eles a espinha só quebra no dia em que alguém ligar;
#   contratos  sem eles /ready responde 200 e TODO lote de GPS volta 503 sem
#              uma linha de log (PB19-D3b).
# Identidade de commit da imagem. Não é `LABEL` nem variável de runtime: entra
# no carimbo de `dist/`, junto do hash das fontes, para que o artefato saiba de
# onde veio mesmo depois de copiado para outro estágio.
ARG DELIVERYOS_COMMIT=""
ENV DELIVERYOS_COMMIT=$DELIVERYOS_COMMIT

RUN npx tsc && node tools/copiar_migrations.js && node tools/copiar_conference_brain.js \
    && node tools/copiar_contratos.js && node tools/carimbar_build.js

# `pg` é dependência de RUNTIME e precisa sobreviver ao prune.
RUN npm prune --omit=dev

# ---------------------------------------------------------------- runtime
FROM node:22-bookworm-slim AS runtime

# `dumb-init` no PID 1 encaminha sinais. Sem ele o SIGTERM do `docker stop`
# não chega ao Node, o encerramento gracioso não roda, e um job em andamento
# só volta quando o lease vencer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends dumb-init \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app

# Usuário sem privilégio. O `node` já existe na imagem base.
COPY --from=build --chown=node:node /build/node_modules ./node_modules
COPY --from=build --chown=node:node /build/dist ./dist
COPY --from=build --chown=node:node /build/package.json ./package.json

USER node

# Documenta a porta do crítico. O worker assíncrono não escuta nada.
EXPOSE 8080

# Sem CMD: cada serviço da composição declara o seu. Um CMD padrão aqui faria
# um erro de configuração subir silenciosamente o processo errado.
ENTRYPOINT ["dumb-init", "--"]
