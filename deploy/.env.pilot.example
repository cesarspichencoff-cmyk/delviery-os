# DeliveryOS Cloud Pilot V1 — contrato de ambiente
#
# Copie para deploy/.env (não versionado) e preencha.
# Este arquivo é só o molde: nenhum valor aqui é real.
#
# Existe separado do .env.example da raiz de propósito — aquele é do
# pipeline de ingestão de dados, este é do serviço hospedado. Misturar os
# dois faria alguém carregar credencial de servidor num script de parser.
#
# Em modo remoto (ENTREGAS_ENV=cloud, ou bind fora do loopback) as variáveis
# marcadas OBRIGATÓRIO derrubam o boot se faltarem. É deliberado: num
# servidor remoto ninguém está lendo o terminal para ver um aviso.

# --------------------------------------------------------------- ambiente
# local | pilot | cloud
ENTREGAS_ENV=cloud

# Bind INTERNO do processo. Em container é 0.0.0.0 — quem publica é o proxy.
# Esta porta NUNCA deve ser publicada direto na internet.
ENTREGAS_BIND=0.0.0.0
ENTREGAS_UI_PORT=5193

# URL pública, atrás do proxy. Precisa ser https:// quando presente: o GPS
# não liga fora de contexto seguro, nem no navegador nem no container Android.
ENTREGAS_PUBLIC_URL=https://entregas.exemplo.com.br

# --------------------------------------------------------------- dados
# OBRIGATÓRIO em modo remoto. Precisa apontar para VOLUME PERSISTENTE.
# Sem isto o container grava em camada efêmera e perde a viagem no restart.
ENTREGAS_DATA_DIR=/dados
ENTREGAS_BACKUP_DIR=backups

# --------------------------------------------------------------- acesso
# OBRIGATÓRIO em modo remoto.
# Formato: actor_id:papel:rótulo:token — separados por ';'
# Papéis: gerente | lider_delivery | operador_expedicao | motoboy_interno
#
# Regras aplicadas no boot, que derrubam o processo:
#   - token contendo CHANGE_ME / EXEMPLO / TODO / SEU_TOKEN;
#   - token com menos de 24 caracteres em modo remoto;
#   - dois usuários com o mesmo token;
#   - actor_id repetido.
#
# Gere cada token assim:  openssl rand -hex 24
ENTREGAS_USERS=ops-1:operador_expedicao:Operador:GERE_UM_TOKEN;ger-1:gerente:Gerente:GERE_OUTRO_TOKEN;rid-1:motoboy_interno:Motoboy:GERE_MAIS_UM

# OBRIGATÓRIO em modo remoto. Lista separada por vírgula. '*' é recusado.
# Sem isto, qualquer página da internet poderia falar com a API a partir do
# navegador de quem estivesse logado.
ENTREGAS_ALLOWED_ORIGINS=https://entregas.exemplo.com.br

# --------------------------------------------------------------- TLS
# O proxy termina o TLS; o processo interno fica em HTTP dentro da rede
# privada do compose. Só use os itens abaixo se o processo servir TLS direto.
# Certificado e chave ficam FORA do repositório, montados como volume.
# ENTREGAS_HTTPS=1
# ENTREGAS_TLS_CERT=/certs/entregas.pem
# ENTREGAS_TLS_KEY=/certs/entregas-key.pem

# --------------------------------------------------------------- unidade
ENTREGAS_UNIT_ID=ITAIM
# Configurações externas (fora do Git), montadas somente-leitura.
ENTREGAS_PILOT_CONFIG=/config/entregas-pilot.json
ENTREGAS_UNIT_CONFIG=/config/entregas-unit-itaim.json
ENTREGAS_TERM_CONFIG=/config/entregas-term.json

# --------------------------------------------------------------- APK
# Hash do APK que a página de distribuição oferece, para o operador conferir
# que instalou o binário certo.
ENTREGAS_APK_SHA256=
ENTREGAS_APK_VERSION=

# --------------------------------------------------------------- logs
# debug | info | warn | error
ENTREGAS_LOG_LEVEL=info

# Controles de demonstração ficam DESLIGADOS em piloto e em nuvem.
ENTREGAS_DEMO_CONTROLS=false
